# LLM provider: anthropic | groq | ollama  (one-line switch, no code edits)
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Groq (OpenAI-compatible) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (local) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b

# Path to the governance DB built by etl/build_db.py (defaults to ../data/claris.duckdb)
# CLARIS_DB=./data/claris.duckdb
